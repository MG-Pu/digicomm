def nr_pss(N_ID2:int) -> np.ndarray:
    if N_ID2 not in (0,1,2):
        raise ValueError("N_ID2 must be 0, 1, or 2")

    s=np.array([0,1,1,0,1,1,1],dtype=np.uint8)
    c=np.zeros(127,dtype=np.uint8)

    for n in range(7):
        c[n]=s[n]
    for n in range(120):
        c[n+7]=c[n]^c[n+4]

    shift=43*N_ID2
    d_bin=np.roll(c,-shift)

    d=(1-2*d_bin.astype(np.int8)).astype(np.float32)

    return d


def map_pss_to_fft_bins(pss127:np.ndarray, Nfft:int, k_min:int=-63) -> np.ndarray:
    if len(pss127) != 127:
        raise ValueError("pss127 must be length 127")

    X=np.zeros(Nfft, dtype=np.complex64)

    for i in range(127):
        k=k_min+i
        bin_idx=(k%Nfft)
        X[bin_idx]=np.complex64(pss127[i])

    return X

def pss_time_domain(N_ID2: int, Nfft: int=2048, Ncp: int=144, k_min: int=-63):
    pss=nr_pss(N_ID2)
    X=map_pss_to_fft_bins(pss, Nfft, k_min)
    x_td=np.fft.ifft(X).astype(np.complex64)
    x_cp=np.concatenate([x_td[-Ncp:], x_td])

    return x_cp


    
def nr_sss(N_ID1: int,N_ID2: int) -> np.ndarray:#生成频域sss序列
    """
    5G NR SSS per 3GPP TS 38.211 §7.4.2.3
      - Length 127, BPSK in {+1, -1}
      - 2 m-seq (degree-7, poly1 x^7 + x^4 + 1, poly2 x^7 + x + 1), init state = 0000001 on both
      - cyclic shifts by m0 = 15*floor(N_ID1/112) + 5*N_ID2, m1 = N_ID1%112
输入参数N_ID1(0~335)和N_ID2(0~2)，
这两个参数组合起来N_ID^cell=3xN_ID1+N_ID2就可以标识1008个不同的物理小区ID
    Returns: float32 array of shape (127,) with values in {+1, -1}
    """
    if N_ID2 not in (0, 1, 2):
        raise ValueError("N_ID2 must be 0, 1, or 2")
    if (N_ID1 < 0) or (N_ID1 > 335):
        raise ValueError("N_ID1 must be 0...335")
        
    # LFSR state s[0..6], spec init: 0 0 0 0 0 0 0
    s0 = np.array([1,0,0,0,0,0,0], dtype=np.uint8)
    s1 = np.array([1,0,0,0,0,0,0], dtype=np.uint8)
    #两个7阶线性反馈移位寄存器，对应多项式x^7+x^4+1和x^7+x+1，代码中初始状态s0和s1被设置为[1,0,0,0,0,0,0]

    # Generate base m-sequence c(n), n=0..126
   
    c0 = np.empty(127, dtype=np.uint8)
    c1 = np.empty(127, dtype=np.uint8)

    for n in range(7):
        c0[n] = s0[n]
        c1[n] = s1[n]

    for n in range(120):
        c0[n+7] = c0[n] ^ c0[n+4]
        c1[n+7] = c1[n] ^ c1[n+1]
        
    # Apply cyclic shift (43*N_ID2), d(n) = c(n + 43*N_ID2 mod 127)
    m0 = 15 * (N_ID1//112) + 5*N_ID2
    m1 = N_ID1 % 112
    #循环以为根据公式计算出来的两个循环移位量m0和m1
    
    d0_bin = np.roll(c0, -m0)
    d1_bin = np.roll(c1, -m1)
    
    # Map to BPSK: 0 -> +1, 1 -> -1
    d = (1 - 2*d0_bin.astype(np.int8)).astype(np.float32) * (1 - 2*d1_bin.astype(np.int8)).astype(np.float32)
   #将生成的两个二进制序列进行异或(模2加)
    return d

def map_sss_to_fft_bins(sss127:np.ndarray, Nfft:int, k_min:int=-56) -> np.ndarray:
    if len(sss127) != 127:
        raise ValueError("sss127 must be length 127")

    X=np.zeros(Nfft, dtype=np.complex64)
#56到182位置
    for i in range(127):
        k=k_min+i
        bin_idx=(k%Nfft)
        X[bin_idx]=np.complex64(sss127[i])

    return X


# --- Build time-domain OFDM symbol and add CP (length Ncp) ---
def sss_time_domain(N_ID1: int, N_ID2: int, Nfft: int = 2048, Ncp: int = 144, k_min: int = -56):
    sss = nr_sss(N_ID1,N_ID2)
    X = map_sss_to_fft_bins(sss, Nfft, k_min)
    x_td = np.fft.ifft(X).astype(np.complex64)      # no fftshift anywhere
    x_cp = np.concatenate([x_td[-Ncp:], x_td])      # prepend cyclic prefix
    return x_cp




