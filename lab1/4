def binary_search_freq_offset(y, x, fs, bounds=(-7500, 7500), iterations=8):
    low, high = bounds
    for step in range(iterations):
        mid1 = low + (high - low) / 3
        mid2 = high - (high - low) / 3
        
        # 计算两个点的 Y 值
        n_seq = np.arange(len(x))
        Y_mid1 = np.abs(np.sum(y * np.conj(x) * np.exp(-2j * np.pi * n_seq * mid1 / fs)))**2
        Y_mid2 = np.abs(np.sum(y * np.conj(x) * np.exp(-2j * np.pi * n_seq * mid2 / fs)))**2
        
        # 缩小范围
        if Y_mid1 > Y_mid2:
            high = mid2
        else:
            low = mid1
            
    return (low + high) / 2

